{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opptra service manifest",
  "description": "Facts only. odlc (scripts/odlc.py) and scripts/generate.py decide CI, rules, and deploy from these facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "purpose", "prod_project", "region"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,48}$"
    },
    "prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,20}$",
      "description": "Short project/app prefix applied to all external GCP resources (<prefix>-<resource>). Defaults to name."
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "What this app is for, in a sentence or two. Written into the README."
    },
    "prod_project": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "preset": {
      "type": "string",
      "enum": ["staff-dashboard", "http-api", "scheduled-jobs", "worker", "config"]
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "run": {
            "type": "string",
            "enum": ["service", "job", "worker", "site", "config"]
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "frontend_path": {
            "type": "string",
            "minLength": 1
          },
          "auth": {
            "type": "string",
            "enum": ["app-login", "iap", "public", "shared-secret", "none"]
          },
          "command": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string"
          },
          "schedules": {
            "type": "array",
            "items": { "type": "string" }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "memory": {
            "type": "string"
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,80}$"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postgres": { "type": ["boolean", "object", "string"] },
        "firestore": { "type": ["boolean", "object", "string"] },
        "bigquery": { "type": ["boolean", "object", "string"] },
        "bucket": { "type": ["boolean", "object", "string"] },
        "queue": { "type": ["boolean", "object", "string"] },
        "schedule": { "type": ["boolean", "object", "string"] },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,80}$"
          }
        },
        "alerts": { "type": ["boolean", "object", "string"] }
      }
    },
    "unmet": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "need", "suggestion"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "need": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "archetype", "auth", "parts"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "archetype": {
            "type": "string",
            "enum": [
              "cloud-run-service",
              "cloud-run-job",
              "scheduled-jobs",
              "vm-worker",
              "config-only"
            ]
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "Optional per-component GCP region override (defaults to top-level region)."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Optional working directory for Python/backend code in existing repositories (defaults to components/<name>)."
          },
          "frontend_path": {
            "type": "string",
            "minLength": 1,
            "description": "Optional working directory for UI code in existing repositories (defaults to components/<name>/frontend)."
          },
          "docker_context": {
            "type": "string",
            "minLength": 1,
            "description": "Docker build context relative to the repo root. Omit it to build Dockerfile inside the component directory. Set it with dockerfile when the image must see files outside that directory."
          },
          "dockerfile": {
            "type": "string",
            "minLength": 1,
            "description": "Dockerfile path relative to the repo root. Required together with docker_context, and the file must sit inside that context."
          },
          "auth": {
            "type": "string",
            "enum": ["app-login", "iap", "public", "shared-secret", "none"]
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["ui", "api", "job", "worker", "config"]
            }
          },
          "database": {
            "type": "string",
            "enum": ["postgres", "firestore", "bigquery", "none"],
            "description": "postgres adds Cloud SQL (or connects to pre-existing Postgres when postgres_instance or postgres_external is set). firestore adds default Firestore IAM. bigquery adds BigQuery IAM/rules/client. Omit or use none when the component does not store data."
          },
          "postgres_instance": {
            "type": "string",
            "minLength": 1,
            "description": "Optional pre-existing Cloud SQL connection name (<project>:<region>:<instance>). Connects and grants cloudsql.client IAM without creating a new instance."
          },
          "postgres_secret": {
            "type": "string",
            "minLength": 1,
            "description": "Optional pre-existing Secret Manager secret ID holding the password or DATABASE_URL for postgres_instance."
          },
          "postgres_external": {
            "type": "boolean",
            "description": "When true with database: postgres, skips Cloud SQL creation in Terraform and connects via DATABASE_URL secret/env."
          },
          "bigquery": {
            "type": "boolean"
          },
          "bigquery_project": {
            "type": "string",
            "minLength": 1,
            "description": "Optional pre-existing GCP project ID hosting BigQuery datasets (defaults to prod_project)."
          },
          "bigquery_datasets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,150}$"
            },
            "description": "Optional list of pre-existing BigQuery dataset IDs (dataset or project.dataset) granted roles/bigquery.dataEditor."
          },
          "extra_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^roles/[A-Za-z0-9._-]+$"
            },
            "description": "Optional extra GCP project IAM roles granted to this component's runtime service account (e.g. roles/aiplatform.user)."
          },
          "custom_terraform": {
            "type": "boolean",
            "description": "When true, scaffolds and preserves infra/custom.keep.tf for custom GCP resources."
          },
          "bucket": {
            "type": "string",
            "enum": ["private", "none"]
          },
          "existing_bucket": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$",
            "description": "Optional pre-existing GCS bucket name. Grants roles/storage.objectAdmin without creating a new bucket."
          },
          "queue": {
            "type": "string"
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,80}$"
            }
          },
          "existing_secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,80}$"
            },
            "description": "Environment variable names backed by pre-existing/shared Secret Manager secrets (mounts and grants secretAccessor IAM without creating secret shells in module.secrets)."
          },
          "secret_map": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            },
            "description": "Optional brownfield map of environment variable name to existing GCP Secret Manager secret ID (e.g. SLACK_BOT_TOKEN: slack-bot-token)."
          },
          "legacy_service_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,48}$",
            "description": "Optional brownfield Cloud Run service name override when importing an existing unprefixed live service."
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Non-secret variables such as a domain, port, email list, or flag. A list is one comma-separated string. Keys and passwords belong in secrets."
          },
          "alerts": {
            "type": "boolean"
          },
          "run_tests": {
            "type": "boolean",
            "description": "Set to false only when legacy tests cannot run without external inputs and the developer chose to disable them temporarily."
          },
          "run_lint": {
            "type": "boolean",
            "description": "Set to false only when legacy lint checks cannot pass without user input and the developer chose to disable them temporarily."
          },
          "receiver": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "auth"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,40}$"
              },
              "auth": {
                "type": "string",
                "enum": ["shared-secret", "public", "iap"]
              },
              "command": {
                "type": "string"
              },
              "queue": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,40}$"
              },
              "secrets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,80}$"
                }
              }
            }
          },
          "jobs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "command"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{1,40}$"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "enabled": {
                  "type": "boolean"
                },
                "timezone": {
                  "type": "string"
                },
                "schedules": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "memory": {
                  "type": "string"
                },
                "secrets": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,80}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
