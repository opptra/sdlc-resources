{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opptra service manifest",
  "description": "Facts only. scripts/generate.py decides CI, rules, and deploy from these facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "purpose", "prod_project", "region", "components"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,48}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "What this app is for, in a sentence or two. Written into the README."
    },
    "prod_project": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "archetype", "auth", "parts"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "archetype": {
            "type": "string",
            "enum": ["cloud-run-service", "cloud-run-job", "vm-worker", "config-only"]
          },
          "auth": {
            "type": "string",
            "enum": ["app-login", "iap", "public", "none"]
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["ui", "api", "job", "worker", "config"]
            }
          },
          "database": {
            "type": "string",
            "enum": ["postgres", "none"],
            "description": "postgres adds Cloud SQL. Omit or use none when the component does not store data."
          }
        }
      }
    }
  }
}
