{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opptra service manifest",
  "description": "Facts only. scripts/sdlc.py and scripts/generate.py decide CI, rules, and deploy from these facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "purpose", "prod_project", "region"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,48}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "What this app is for, in a sentence or two. Written into the README."
    },
    "prod_project": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "preset": {
      "type": "string",
      "enum": ["staff-dashboard", "http-api", "scheduled-jobs", "worker", "config"]
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "run": {
            "type": "string",
            "enum": ["service", "job", "worker", "site", "config"]
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "frontend_path": {
            "type": "string",
            "minLength": 1
          },
          "auth": {
            "type": "string",
            "enum": ["app-login", "iap", "public", "shared-secret", "none"]
          },
          "command": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "timezone": {
            "type": "string"
          },
          "schedules": {
            "type": "array",
            "items": { "type": "string" }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "memory": {
            "type": "string"
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{1,48}$"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postgres": { "type": ["boolean", "object", "string"] },
        "firestore": { "type": ["boolean", "object", "string"] },
        "bigquery": { "type": ["boolean", "object", "string"] },
        "bucket": { "type": ["boolean", "object", "string"] },
        "queue": { "type": ["boolean", "object", "string"] },
        "schedule": { "type": ["boolean", "object", "string"] },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,48}$"
          }
        },
        "alerts": { "type": ["boolean", "object", "string"] }
      }
    },
    "unmet": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "need", "suggestion"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "need": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "archetype", "auth", "parts"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "archetype": {
            "type": "string",
            "enum": [
              "cloud-run-service",
              "cloud-run-job",
              "scheduled-jobs",
              "vm-worker",
              "config-only"
            ]
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "Optional per-component GCP region override (defaults to top-level region)."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Optional working directory for Python/backend code in existing repositories (defaults to components/<name>)."
          },
          "frontend_path": {
            "type": "string",
            "minLength": 1,
            "description": "Optional working directory for UI code in existing repositories (defaults to components/<name>/frontend)."
          },
          "auth": {
            "type": "string",
            "enum": ["app-login", "iap", "public", "shared-secret", "none"]
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["ui", "api", "job", "worker", "config"]
            }
          },
          "database": {
            "type": "string",
            "enum": ["postgres", "firestore", "bigquery", "none"],
            "description": "postgres adds Cloud SQL. firestore adds default Firestore IAM. bigquery adds BigQuery rules/client. Omit or use none when the component does not store data."
          },
          "bigquery": {
            "type": "boolean"
          },
          "bucket": {
            "type": "string",
            "enum": ["private", "none"]
          },
          "queue": {
            "type": "string"
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{1,48}$"
            }
          },
          "alerts": {
            "type": "boolean"
          },
          "receiver": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "auth"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,40}$"
              },
              "auth": {
                "type": "string",
                "enum": ["shared-secret", "public", "iap"]
              },
              "command": {
                "type": "string"
              },
              "queue": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,40}$"
              },
              "secrets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{1,48}$"
                }
              }
            }
          },
          "jobs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "command"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{1,40}$"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "enabled": {
                  "type": "boolean"
                },
                "timezone": {
                  "type": "string"
                },
                "schedules": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "memory": {
                  "type": "string"
                },
                "secrets": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{1,48}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
